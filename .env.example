DATABASE_URL=postgresql+asyncpg://maintainer:maintainer@localhost:5433/maintainer
POSTGRES_HOST_PORT=5433
GITHUB_API_URL=https://api.github.com
GITHUB_AUTH_MODE=auto
# Recommended production authentication:
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=
# Fine-grained read-only local fallback:
GITHUB_TOKEN=
AUTO_SCAN_ON_STARTUP=true
AUTO_SCAN_INTERVAL_MINUTES=0
SCAN_STALE_AFTER_MINUTES=360
MAX_CONCURRENT_SCANS=3
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
JULES_API_KEY=
JULES_SOURCE_REPOSITORY=HazemHassine/GitAudit
JULES_STARTING_BRANCH=main

# Single-owner mutation/login protection. Use a long unique password.
OWNER_PASSWORD=
OWNER_SESSION_SECRET=
OWNER_COOKIE_SECURE=false
# Local audit worker defaults (Jules quota never exceeds 80 per rolling 24h).
AUDIT_DAILY_SESSIONS=80
AUDIT_JULES_SLOTS=3
AUDIT_ALLOW_WORKFLOW_EDITS=false

# Set to: stat -c %g /var/run/docker.sock
DOCKER_GID=0
